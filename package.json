{
  "name": "http4",
  "version": "0.2.0",
  "description": "HTTP/4 — agent-native, cost-aware, DoS-resistant evolution of HTTP over QUIC with C11 N-API acceleration, SDK, and HTTP/1.1–3 interoperability.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "http4": "./bin/http4.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    },
    "./sdk": "./src/sdk.js",
    "./adapters": "./src/adapters.js",
    "./gateway": "./src/gateway.js",
    "./wire": "./src/wire.js",
    "./h3-compat": "./src/h3-compat.js",
    "./privacy-pass": "./src/privacy-pass.js",
    "./native": "./src/native.js"
  },
  "scripts": {
    "postinstall": "node scripts/build-native.js || true",
    "build:native": "node scripts/build-native.js",
    "doctor": "node bin/http4.js doctor",
    "test": "node test/run.js && node test/security-audit.js",
    "test:unit": "node test/run.js",
    "test:san": "node scripts/build-native.js --san",
    "test:security": "node test/security-audit.js",
    "test:purejs": "H4_PURE_JS=1 node test/run.js && H4_PURE_JS=1 node test/security-audit.js",
    "bench": "node bench/bench.js",
    "scenario": "node demo.js",
    "example": "node examples/agent-mesh.js",
    "server": "node src/server.js",
    "attack": "node bench/attack-sim.js"
  },
  "keywords": [
    "http4",
    "quic",
    "http3",
    "protocol",
    "agents",
    "ddos",
    "capabilities",
    "macaroons",
    "privacy-pass",
    "napi"
  ],
  "license": "CC-BY-4.0 OR MIT",
  "engines": {
    "node": ">=20"
  }
}
